{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": false,
  "packages": {
    ".": {
      "package-name": "moonraker-home-assistant",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "custom_components/moonraker/manifest.json",
          "jsonpath": "$.version"
        },
        {
          "type": "generic",
          "path": "custom_components/moonraker/const.py"
        }
      ]
    }
  }
}
